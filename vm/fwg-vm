#!/usr/bin/env bash
# fwg-vm — throwaway QEMU/KVM test machines for fwg (tier 4 in STACK_NOTES.md).
#
# Each VM boots from a read-only official cloud image through a copy-on-write overlay,
# so `reset` gives a factory-fresh machine in seconds. No root needed: networking is
# QEMU user-mode, and SSH is forwarded to 127.0.0.1 only.
#
# Usage:
#   vm/fwg-vm up     <debian|ubuntu>        boot (first boot provisions via cloud-init)
#   vm/fwg-vm ssh    <debian|ubuntu> [cmd]  shell or run a command as user `fwg` (passwordless sudo)
#   vm/fwg-vm push   <debian|ubuntu> <file> [dest]   copy a file into the VM (default dest: ~)
#   vm/fwg-vm pull   <debian|ubuntu> <file> <dest>   copy a file out of the VM (path relative to ~)
#   vm/fwg-vm down   <debian|ubuntu>        clean shutdown
#   vm/fwg-vm reset  <debian|ubuntu>        shut down and delete the overlay (fresh VM next `up`)
#   vm/fwg-vm status                        show which VMs are running
#   vm/fwg-vm console <debian|ubuntu>       follow the serial console log
set -euo pipefail

readonly VM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly IMAGES="$VM_DIR/images"
readonly STATE="$VM_DIR/state"
readonly KEY="$STATE/id_ed25519"
readonly BOOT_TIMEOUT_SECS=300
readonly DISK_SIZE=10G
readonly MEMORY_MB=2048
readonly CPUS=2
# Installed by cloud-init on first boot; `up` checks they really are.
readonly PACKAGES=(nftables openssh-server python3 socat netcat-openbsd conntrack iproute2)

die() { printf 'fwg-vm: %s\n' "$*" >&2; exit 1; }

# distro → base image, SSH port, seed HTTP port
vm_config() {
  case "$1" in
    debian) BASE="$IMAGES/debian-13-genericcloud-amd64.qcow2"; SSH_PORT=2201; SEED_PORT=8701 ;;
    ubuntu) BASE="$IMAGES/noble-server-cloudimg-amd64.img";    SSH_PORT=2202; SEED_PORT=8702 ;;
    *) die "unknown VM '$1' (use: debian, ubuntu)" ;;
  esac
  NAME="$1"
  DISK="$STATE/$NAME.qcow2"
  PIDFILE="$STATE/$NAME.pid"
  LOG="$STATE/$NAME-console.log"
  SEED="$STATE/$NAME-seed"
}

is_running() { [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

ssh_opts=(
  -i "$KEY"
  # Throwaway local VMs get a new host key on every reset; pinning it would only
  # produce false alarms. Reachable on 127.0.0.1 only.
  -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
  -o LogLevel=ERROR -o ConnectTimeout=5 -o BatchMode=yes
)

ensure_key() {
  mkdir -p "$STATE"
  chmod 700 "$STATE"
  [[ -f "$KEY" ]] || ssh-keygen -q -t ed25519 -N '' -C 'fwg-test-vm' -f "$KEY"
}

write_seed() {
  mkdir -p "$SEED"
  local pubkey; pubkey="$(cat "$KEY.pub")"
  cat > "$SEED/meta-data" <<EOF
instance-id: fwg-$NAME-$(date +%s)
local-hostname: fwg-$NAME
EOF
  cat > "$SEED/user-data" <<EOF
#cloud-config
users:
  - name: fwg
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - $pubkey
ssh_pwauth: false
package_update: true
packages:
$(printf '  - %s\n' "${PACKAGES[@]}")
EOF
  : > "$SEED/vendor-data"
}

cmd_up() {
  vm_config "$1"
  is_running && { echo "$NAME already running (ssh port $SSH_PORT)"; return; }
  [[ -f "$BASE" ]] || die "base image missing: $BASE"
  [[ -r /dev/kvm && -w /dev/kvm ]] || die "/dev/kvm not accessible"
  ensure_key
  if [[ ! -f "$DISK" ]]; then
    qemu-img create -q -f qcow2 -F qcow2 -b "$BASE" "$DISK" "$DISK_SIZE"
    write_seed
  fi

  # cloud-init fetches its seed from http://10.0.2.2 (= host 127.0.0.1 via user-mode net).
  python3 -I -m http.server --bind 127.0.0.1 --directory "$SEED" "$SEED_PORT" >/dev/null 2>&1 &
  local seed_pid=$!
  # Expand now: the local variable is gone by the time the EXIT trap runs.
  # shellcheck disable=SC2064
  trap "kill $seed_pid 2>/dev/null || true" EXIT

  qemu-system-x86_64 \
    -name "fwg-$NAME" -machine q35,accel=kvm -cpu host -m "$MEMORY_MB" -smp "$CPUS" \
    -drive "file=$DISK,if=virtio,format=qcow2" \
    -netdev "user,id=n0,hostfwd=tcp:127.0.0.1:$SSH_PORT-:22" \
    -device virtio-net-pci,netdev=n0 \
    -smbios "type=1,serial=ds=nocloud;s=http://10.0.2.2:$SEED_PORT/" \
    -display none -serial "file:$LOG" \
    -daemonize -pidfile "$PIDFILE"

  echo "booting $NAME (console log: $LOG) ..."
  local deadline=$((SECONDS + BOOT_TIMEOUT_SECS))
  until ssh "${ssh_opts[@]}" -p "$SSH_PORT" fwg@127.0.0.1 true 2>/dev/null; do
    (( SECONDS < deadline )) || die "$NAME: no SSH after ${BOOT_TIMEOUT_SECS}s (see $LOG)"
    sleep 3
  done
  echo "waiting for cloud-init to finish provisioning ..."
  ssh "${ssh_opts[@]}" -p "$SSH_PORT" fwg@127.0.0.1 'cloud-init status --wait >/dev/null; cloud-init status'
  # cloud-init reports success even when apt could not reach the mirror.
  local installed
  installed="$(ssh "${ssh_opts[@]}" -p "$SSH_PORT" fwg@127.0.0.1 \
    "dpkg-query -W -f='\${db:Status-Status}\n' ${PACKAGES[*]} 2>/dev/null | grep -cx installed" || true)"
  [[ "$installed" == "${#PACKAGES[@]}" ]] \
    || die "$NAME: provisioning did not install the packages (network?); try: vm/fwg-vm reset $NAME"
  echo "$NAME ready: vm/fwg-vm ssh $NAME"
}

cmd_ssh() {
  vm_config "$1"; shift
  is_running || die "$NAME is not running (vm/fwg-vm up $NAME)"
  exec ssh "${ssh_opts[@]}" -p "$SSH_PORT" fwg@127.0.0.1 "$@"
}

cmd_push() {
  vm_config "$1"
  [[ -f "${2:-}" ]] || die "file not found: ${2:-<none>}"
  is_running || die "$NAME is not running"
  scp "${ssh_opts[@]}" -P "$SSH_PORT" "$2" "fwg@127.0.0.1:${3:-}"
}

cmd_pull() {
  vm_config "$1"
  [[ -n "${2:-}" && -n "${3:-}" ]] || die "usage: fwg-vm pull <vm> <file> <dest>"
  is_running || die "$NAME is not running"
  scp "${ssh_opts[@]}" -P "$SSH_PORT" "fwg@127.0.0.1:$2" "$3"
}

cmd_down() {
  vm_config "$1"
  is_running || { echo "$NAME not running"; return; }
  ssh "${ssh_opts[@]}" -p "$SSH_PORT" fwg@127.0.0.1 'sudo systemctl poweroff' 2>/dev/null || true
  local deadline=$((SECONDS + 60))
  while is_running && (( SECONDS < deadline )); do sleep 1; done
  if is_running; then kill "$(cat "$PIDFILE")"; fi
  rm -f "$PIDFILE"
  echo "$NAME stopped"
}

cmd_reset() {
  vm_config "$1"
  cmd_down "$1"
  rm -rf "$DISK" "$SEED" "$LOG"
  echo "$NAME reset: next 'up' boots a fresh machine"
}

cmd_status() {
  for d in debian ubuntu; do
    vm_config "$d"
    if is_running; then echo "$d: running (ssh -p $SSH_PORT)"; else echo "$d: stopped"; fi
  done
}

cmd_console() { vm_config "$1"; exec tail -f "$LOG"; }

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    up|ssh|push|pull|down|reset|console) [[ $# -ge 1 ]] || die "usage: fwg-vm $cmd <debian|ubuntu>"; "cmd_$cmd" "$@" ;;
    status) cmd_status ;;
    *) sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
  esac
}

main "$@"
